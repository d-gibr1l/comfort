<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GalleryDL" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- MainActivity's cold-start theme (see AndroidManifest.xml) — shown for the brief instant
         between process start and the first Compose frame being ready. Not android:-namespaced:
         these are core-splashscreen's own compat attrs (via the Theme.SplashScreen parent), which
         work identically across every API level instead of only 31+. postSplashScreenTheme is what
         switches the activity's real theme back once installSplashScreen()'s condition is met. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFFFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.GalleryDL</item>
    </style>

    <!-- Used only by ShareActivity: a fullscreen but see-through window so the app it was
         shared from (Twitter, Reddit, a browser, ...) stays visible behind the picker sheet,
         instead of a normal opaque Activity transition that reads as "leaving" that app. -->
    <style name="Theme.GalleryDL.Transparent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>