<?xml version="1.0" encoding="utf-8"?>
<!-- The video viewer's player. A TextureView, not the default SurfaceView: a SurfaceView is a hole
     in the window, so the video's first frame shown until playback starts had to be drawn over it,
     and it flickered black as the surface was added and as that frame was taken away. A
     TextureView draws like any view, over the frame shown beneath it. The surface type can only be
     set here (PlayerView has no setter for it). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:shutter_background_color="@android:color/transparent" />
