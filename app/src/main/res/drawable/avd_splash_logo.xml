<?xml version="1.0" encoding="utf-8"?>
<!-- The staggered-fade splash entrance: COM, then FOR, then the arrow, each fading + scaling in
     from its own center — same timing as the web mockup this was built and approved against. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_splash_logo">
    <target
        android:name="path_com"
        android:animation="@animator/splash_com_anim" />
    <target
        android:name="path_for"
        android:animation="@animator/splash_for_anim" />
    <target
        android:name="path_arrow"
        android:animation="@animator/splash_arrow_anim" />
</animated-vector>
