<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reading current network capabilities (validated/metered/...) for the Queue's "waiting for
         network" indicator on a stuck download — a normal permission, granted automatically. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only needed on API 24-28; API 29+ (scoped storage) writes to the gallery via MediaStore without it. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Download progress/completion notifications, and keeping the download alive as a foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Lets Settings > Downloads > Reliability launch the system's own "exempt this app from
         battery optimization" dialog (code review #19) — without it, a burst of "Start Now" taps
         can exhaust the expedited-job quota and the resulting plain background job gets silently
         held indefinitely by Battery Saver once the app is backgrounded. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Lets this app launch Android's own package installer on a freshly downloaded update APK
         (AppUpdater.installApk) — this app isn't Play-distributed, so an in-app update check needs
         this the same way any sideloaded APK's own self-update flow does. Doesn't itself grant the
         install; the user still confirms per-app in Settings (AppUpdater.canInstall/
         requestInstallPermission), same two-step shape as the battery-optimization exemption above. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:extractNativeLibs="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.GalleryDL"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets other apps (Twitter, Instagram, a browser, ...) share a link straight into the
             download flow via their own Share sheet. Handled by a separate, transparent-themed
             activity (rather than MainActivity) so it renders as a bottom sheet floating over
             whatever app the user was in, instead of visibly switching to this app. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:theme="@style/Theme.GalleryDL.Transparent"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <!-- singleTask: at most one instance of this Activity ever exists — a share arriving
                 while one's already open reuses it (delivered via onNewIntent, see its own doc
                 comment in ShareActivity.kt) instead of creating another one on top. Without this,
                 the default launchMode lets instances pile up indefinitely, one per share — most
                 of the time invisible since each one normally finish()es itself quickly, but a
                 single instance that doesn't (reproduced live: one left open from Library >
                 Duplicates confirmation-sheet testing) then just sits there forever, its own
                 translucent/dimmed window compositing on top of whatever the user does next in a
                 completely different app.

                 taskAffinity="" (empty, Android's own documented way to mean "no affinity with
                 any task") has to come with it — without it, this Activity defaults to sharing
                 MainActivity's own affinity, and singleTask's "bring the affinity-matching task
                 forward if one already exists" behavior then brings *that whole task* to the
                 foreground first whenever Comfort already has one backgrounded (a normal app open
                 earlier, sent to background) — visibly flashing the main app open for a moment
                 before this Activity's own window ends up on top of it. Reproduced live exactly
                 as reported ("sometimes... it opens Comfort before it opens the preview sheet") —
                 a real regression singleTask introduced (the old default launchMode always
                 launched into the *calling* app's own task, never touching Comfort's). Giving
                 this its own affinity means singleTask never has another task to go bring
                 forward — there's never anything to flash. excludeFromRecents above already keeps
                 that separate task out of the recent-apps list, so nothing user-visible changes
                 about how this is presented, only the flash going away. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Direct link taps (not just Share) for the sites Home advertises as supported,
                 so e.g. tapping a Twitter/Instagram/Pixiv link opens the picker instead of a
                 browser. Deliberately not an exhaustive host list (gallery-dl supports hundreds
                 of sites) — broader coverage here means more "which app" prompts on links that
                 have nothing to do with downloading. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="twitter.com" />
                <data android:scheme="https" android:host="x.com" />
                <data android:scheme="https" android:host="www.twitter.com" />
                <data android:scheme="https" android:host="www.x.com" />
                <data android:scheme="https" android:host="instagram.com" />
                <data android:scheme="https" android:host="www.instagram.com" />
                <data android:scheme="https" android:host="pixiv.net" />
                <data android:scheme="https" android:host="www.pixiv.net" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".worker.DownloadActionReceiver"
            android:exported="false" />

        <!-- Re-evaluates any pending Schedule-window delay against the clock/timezone that's now
             current — see ClockChangeReceiver's own doc comment. TIME_CHANGED/TIMEZONE_CHANGED are
             both still exempt from Android 8's implicit-broadcast restrictions, so a manifest
             registration (unlike most other system broadcasts) still gets delivered here. -->
        <receiver
            android:name=".worker.ClockChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Fires the Schedule window's exact-alarm backstop ("Use alarm for scheduling",
             Settings > Downloads > Schedule) — see ScheduleAlarmReceiver's own doc comment. No
             manifest permission needed: setAndAllowWhileIdle() doesn't require
             SCHEDULE_EXACT_ALARM (only a true setExactAndAllowWhileIdle() would on API 31+). -->
        <receiver
            android:name=".worker.ScheduleAlarmReceiver"
            android:exported="false" />

        <!-- WorkManager's own service, declared here only to add the foregroundServiceType that
             DownloadWorker's ForegroundInfo requires on API 34+; without a matching declaration
             here, setForeground() throws "foregroundServiceType is not a subset of ... manifest". -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Hands a downloaded update APK (AppUpdater, cacheDir/app_update.apk) to the system
             installer as a content:// Uri instead of a file:// one — required since Android 7
             (FileUriExposedException otherwise) for any file this app's own process hands to
             another app/activity, not specific to APKs. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
